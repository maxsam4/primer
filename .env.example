# Database
# The default password matches docker-compose.yml's POSTGRES_PASSWORD fallback.
# When you override POSTGRES_PASSWORD, mirror the change here.
DATABASE_URL=postgres://primer:primer_local_dev@localhost:5432/primer
DATABASE_URL_TEST=postgres://primer:primer_local_dev@localhost:5432/primer_test

# Server
PORT=3000
STORAGE_ROOT=./storage
# Storage backend: filesystem (default; uses STORAGE_ROOT) | gcs (production on
# GKE; uses GCS_BUCKET and authenticates via Workload Identity — no key file).
# STORAGE_BACKEND=gcs
# GCS_BUCKET=
LOG_LEVEL=info

# Authentication — REQUIRED.
# AUTH_MODE: mock | okta | proxy
#   mock = always sign in as MOCK_USER (local dev only; refused when NODE_ENV=production)
#   okta = real Polygon Okta OIDC flow (requires OKTA_* vars below)
#   proxy = trust a signed identity JWT from a reverse proxy (see docs/self-host.md):
#           PROXY_AUTH_HEADER, PROXY_AUTH_ISSUER, PROXY_AUTH_AUDIENCE and one of
#           PROXY_AUTH_PUBLIC_KEY (PEM) / PROXY_AUTH_JWKS_URL
AUTH_MODE=mock

# Cookie Secure flag. Leave unset for local HTTP dev. In production, derived
# automatically when AUTH_BASE_URL starts with https://.
# COOKIE_SECURE=true

# Required only when AUTH_MODE=okta:
# OKTA_ISSUER=https://<polygon-tenant>.okta.com
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
# AUTH_BASE_URL=http://localhost:3000
# SESSION_COOKIE_NAME=primer_sid
# SESSION_TTL_DAYS=14

# Admin allowlist — comma-separated emails, case-insensitive. Admins can read
# /api/admin/stats. Empty/unset = no admins (admin endpoints return 403).
# Agents' tokens are managed by each person under Settings > API tokens.
# For local dev with AUTH_MODE=mock, the mock user's email is mock@polygon.technology.
# ADMIN_EMAILS=you@polygon.technology,teammate@polygon.technology

# OAuth 2.1 (required for remote MCP access via /mcp endpoint)
# OAUTH_ISSUER=http://localhost:3000  # Set to the API base URL when enabling OAuth
# The OAuth 2.1 endpoint will serve metadata at /.well-known/oauth-authorization-server
# and /.well-known/oauth-protected-resource

# Email notifications (optional)
# Mailgun API key + verified sender. Falls back to NoopNotifier when unset.
# MAILGUN_DOMAIN defaults to the host of EMAIL_FROM (the part after `@`).
# MAILGUN_API_BASE_URL defaults to https://api.mailgun.net (use https://api.eu.mailgun.net for EU).
# MAILGUN_API_KEY=
# EMAIL_FROM=primer@dashboard.polygon.technology
# MAILGUN_DOMAIN=dashboard.polygon.technology
# MAILGUN_API_BASE_URL=https://api.mailgun.net
