# Copy to .env next to docker-compose.selfhost.yml. See docs/self-host.md.
POSTGRES_PASSWORD=change-me
AUTH_BASE_URL=https://primer.example.com
ADMIN_EMAILS=you@example.com

# Sign-in through a reverse proxy that forwards a signed identity JWT.
AUTH_MODE=proxy
PROXY_AUTH_HEADER=x-identity
PROXY_AUTH_ISSUER=https://sso.example.com
PROXY_AUTH_AUDIENCE=primer
# Exactly one of these two:
PROXY_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# PROXY_AUTH_JWKS_URL=https://sso.example.com/.well-known/jwks.json

# Optional email (notifications, external-share codes).
# MAILGUN_API_KEY=
# EMAIL_FROM=Primer <primer@example.com>
