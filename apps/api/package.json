{
  "name": "@primer/api",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:test": "tsx src/db/migrate.ts test",
    "db:purge": "tsx src/jobs/purge-cli.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@blocknote/code-block": "0.57.0",
    "@blocknote/core": "0.57.0",
    "@blocknote/diagram-block": "0.57.0",
    "@blocknote/math-block": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@blocknote/server-util": "0.57.0",
    "@hocuspocus/server": "4.8.0",
    "@hono/node-server": "^2.1.5",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@polygonlabs/primer-api-types": "workspace:^",
    "@primer/blocks": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@tiptap/pm": "3.32.3",
    "acorn": "8.19.0",
    "acorn-jsx": "5.3.2",
    "crossws": "0.4.16",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-diff": "1.3.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.34",
    "jsdom": "29.1.1",
    "markdown-it": "^14.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "jose": "^6.2.3",
    "openid-client": "^6.8.4",
    "parse5": "^8.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "roboto-fontface": "0.10.0",
    "sanitize-html": "^2.17.7",
    "uuid": "^14.0.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.8.0",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
